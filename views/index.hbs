<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-primary">📦 Mi Inventario de Repuestos</h2>
    <a href="/productos/nuevo" class="btn btn-success">
        <i class="fas fa-plus"></i> + Nuevo Producto
    </a>
</div>

<div class="table-responsive bg-white shadow-sm p-3 rounded">
    <table class="table table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Imagen</th>
                <th>Nombre</th>
                <th>Precio</th>
                <th>Descripción</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            {{#each productos}}
            <tr>
                <td>
                    {{#if imagen}}
                    <img src="/uploads/{{imagen}}" alt="{{nombre}}" style="width: 60px; height: 60px; object-fit: cover;" class="rounded border shadow-sm">
                    {{else}}
                    <div class="bg-light text-center rounded" style="width: 60px; height: 60px; line-height: 60px;">
                        <small class="text-muted">N/A</small>
                    </div>
                    {{/if}}
                </td>
                <td><strong>{{nombre}}</strong></td>
                <td><span class="badge bg-light text-dark fs-6">${{precio}}</span></td>
                <td class="text-muted">{{descripcion}}</td>
                <td class="text-center">
                    <a href="/productos/eliminar/{{_id}}" 
                       class="btn btn-outline-danger btn-sm" 
                       onclick="return confirm('¿Seguro que quieres eliminar este repuesto?')">
                        Eliminar
                    </a>
                </td>
            </tr>
            {{/each}}
            
            {{#unless productos}}
            <tr>
                <td colspan="5" class="text-center py-4 text-muted">
                    No hay productos registrados aún. ¡Agrega el primero!
                </td>
            </tr>
            {{/unless}}
        </tbody>
    </table>
</div>